# --- Core ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://recall:recall@localhost:5432/recall_tracker
REDIS_URL=redis://localhost:6379

# 32-byte hex key used to encrypt connector tokens at rest. Generate: openssl rand -hex 32
CONNECTOR_ENCRYPTION_KEY=

# --- Public data sources ---
# openFDA: optional key raises the limit from 1,000 to 120,000 requests/day.
# https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# Ingestion cadence (cron, UTC). Sources publish a few times a day; be a good citizen.
INGEST_CRON_FDA=15 */4 * * *
INGEST_CRON_FSIS=5 */2 * * *
INGEST_CRON_CPSC=35 */6 * * *
# Which FDA enforcement endpoints to pull. Food is the focus; others optional.
OPENFDA_ENDPOINTS=food,drug,device
# Initial backfill window when no watermark exists yet.
INGEST_BACKFILL_DAYS=120
# Set to "1" to read recorded fixture responses instead of calling the network (tests/offline dev).
INGEST_USE_FIXTURES=0

# --- Restaurant research cache (premium) ---
# Research is shared by every user tracking the same restaurant and reused until this old.
RESTAURANT_RESEARCH_TTL_DAYS=90
# A manual refresh re-runs the AI only when the cached research is at least this old.
RESTAURANT_RESEARCH_MIN_REFRESH_DAYS=7

# --- Push notifications (Expo) ---
# Optional but recommended: https://docs.expo.dev/push-notifications/push-notifications-setup/#get-credentials-for-development-builds
EXPO_ACCESS_TOKEN=

# --- Premium / AI ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Daily cap on premium AI requests per user.
AI_DAILY_REQUEST_LIMIT=50

# --- Entitlements ---
# Shared secret for the RevenueCat webhook that flips users to premium.
REVENUECAT_WEBHOOK_SECRET=
