// Recall Tracker — database schema.
// One shared Postgres holds every recall pulled from the public sources; clients
// never call FDA/USDA/CPSC directly. Users, devices, watchlists and alerts hang off it.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

enum RecallSource {
  FDA
  FSIS
  CPSC
}

enum RecallCategory {
  food
  meat_poultry
  dietary_supplement
  cosmetic
  drug
  medical_device
  veterinary
  consumer_product
  other
}

enum RecallSeverity {
  critical
  high
  low
  unknown
}

enum RecallStatus {
  ongoing
  completed
  terminated
  pending
  unknown
}

model Recall {
  id                 String         @id @default(cuid())
  source             RecallSource
  sourceId           String
  title              String
  summary            String
  productDescription String
  reason             String
  category           RecallCategory
  severity           RecallSeverity
  status             RecallStatus
  company            String
  brands             String[]
  upcs               String[]
  distributionStates String[]
  recallDate         DateTime?
  publishedAt        DateTime
  sourceUpdatedAt    DateTime?
  url                String?
  imageUrls          String[]
  /// Lot numbers, best-by dates, model numbers: what a consumer compares against their package.
  codeInfo           String?
  /// What the agency/firm says to do (return for refund, discard, contact…).
  remedy             String?
  /// sha256 of the normalised payload; lets ingestion skip untouched records.
  contentHash        String
  /// Original source payload for audit/debug and future re-normalisation.
  raw                Json
  /// Generated tsvector maintained by trigger (see migration); Prisma treats it as Unsupported.
  searchVector       Unsupported("tsvector")?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  alerts Alert[]

  @@unique([source, sourceId])
  @@index([publishedAt(sort: Desc)])
  @@index([category, publishedAt(sort: Desc)])
  @@index([severity, publishedAt(sort: Desc)])
  @@index([upcs], type: Gin)
  @@index([distributionStates], type: Gin)
  @@index([searchVector], type: Gin)
}

/// Per-source sync watermark + run history.
model SourceSyncState {
  source        RecallSource @id
  /// Last successfully ingested source-side date (inclusive window start for next run).
  watermark     DateTime?
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  consecutiveFailures Int @default(0)
}

model IngestRun {
  id          String       @id @default(cuid())
  source      RecallSource
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  ok          Boolean?
  fetched     Int          @default(0)
  inserted    Int          @default(0)
  updated     Int          @default(0)
  unchanged   Int          @default(0)
  alertsCreated Int        @default(0)
  error       String?

  @@index([source, startedAt(sort: Desc)])
}

enum UserTier {
  free
  premium
}

model User {
  id               String    @id @default(cuid())
  installId        String    @unique
  /// sha256 of the bearer token; the raw token lives only on the device.
  tokenHash        String    @unique
  tier             UserTier  @default(free)
  premiumExpiresAt DateTime?
  /// Store-side subscription id (RevenueCat / App Store / Play) for entitlement sync.
  subscriptionRef  String?
  /// Where the user lives (set explicitly or auto-detected once). Used to rank recalls.
  homeState        String?
  /// Most recent state the phone reported (travel). Only the state is stored, never coordinates.
  lastKnownState   String?
  lastLocationAt   DateTime?
  /// --- Notification preferences ---
  /// Lowest severity that triggers a push (alerts below it still land in the inbox).
  pushMinSeverity  RecallSeverity @default(unknown)
  /// Categories never pushed (still visible in the inbox).
  mutedCategories  RecallCategory[] @default([])
  /// Local hours [start, end) during which pushes are held; null = none. Wraps midnight.
  quietHoursStart  Int?
  quietHoursEnd    Int?
  /// IANA timezone reported by the phone, for quiet hours and digests.
  timezone         String?
  /// One daily summary push instead of one per alert (critical alerts still go out immediately).
  digestMode       Boolean   @default(false)
  digestHour       Int       @default(9)
  lastDigestAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  devices    Device[]
  watchItems WatchItem[]
  alerts     Alert[]
  connectors Connector[]
  aiUsage    AiUsage[]
  restaurantNotices RestaurantNotice[]
  receipts   ReceiptScan[]
}

model Device {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoPushToken String   @unique
  platform      String
  enabled       Boolean  @default(true)
  /// Set when Expo reports DeviceNotRegistered; we stop sending to it.
  invalidatedAt DateTime?
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([userId])
}

enum WatchItemKind {
  product
  upc
  scan
  restaurant
  /// "Everything in these categories (at/above a severity, sold in my state)" — no product list needed.
  category
}

model WatchItem {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind              WatchItemKind
  label             String
  terms             String[]
  upc               String?
  context           String?
  ocrText           String?
  categories        RecallCategory[] @default([])
  /// For category subscriptions: ignore recalls below this severity.
  minSeverity       RecallSeverity?
  restaurantName    String?
  restaurantCity    String?
  restaurantState   String?
  restaurantWebsite String?
  importedFrom      String?
  /// Shared research record for restaurant items (one per restaurant, reused across users).
  restaurantProfileId String?
  restaurantProfile   RestaurantProfile? @relation(fields: [restaurantProfileId], references: [id], onDelete: SetNull)
  /// Snapshot of the research applied to this item (summary shown in the app; terms merged into `terms`).
  researchSummary   String?
  researchUpdatedAt DateTime?
  researchJson      Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  alerts Alert[]

  @@index([userId])
  @@index([upc])
  @@index([kind])
  @@index([restaurantProfileId])
}

enum ResearchStatus {
  pending
  researching
  ready
  failed
}

/// One row per real-world restaurant. Research (suppliers, risk signals, sources) is done
/// once and shared by every user tracking that restaurant until it goes stale.
model RestaurantProfile {
  id              String         @id @default(cuid())
  /// Normalised identity: website host when known, else "name|city|state" (see restaurantKey()).
  key             String         @unique
  name            String
  city            String?
  state           String?
  website         String?
  /// Coordinates of the venue (a public place), used for "near me" lookups and geofence alerts.
  latitude        Float?
  longitude       Float?
  researchStatus  ResearchStatus @default(pending)
  summary         String?
  /// Confirmed/likely supplier + brand terms, already filtered of generic words.
  supplierTerms   String[]
  researchJson    Json?
  researchedAt    DateTime?
  researchError   String?
  /// How many times the AI research actually ran (cost visibility).
  researchCount   Int            @default(0)
  /// How many watch items reused the cache instead of triggering research.
  cacheHits       Int            @default(0)
  lastRequestedAt DateTime       @default(now())
  /// --- Health inspection grade (shared, refreshed by the maintenance job) ---
  /// Which adapter supplied the grade: nyc_dohmh, chicago_cdph, ai_research…
  gradeSource     String?
  /// Source-side identifier (e.g. NYC CAMIS, Chicago license number) for exact re-lookup.
  gradeExternalId String?
  /// Current grade as the jurisdiction expresses it: "A", "B", "C", "Pass", "Fail", "92"…
  currentGrade    String?
  /// Numeric score when the jurisdiction uses one (NYC: lower is better; many counties: 0–100 higher is better).
  currentScore    Int?
  /// How to read the grade: letter_abc | score_100 | pass_fail | nyc_points
  gradeScale      String?
  lastInspectedAt DateTime?
  gradeCheckedAt  DateTime?
  gradeError      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  watchItems  WatchItem[]
  inspections RestaurantInspection[]
  notices     RestaurantNotice[]

  @@index([researchStatus, researchedAt])
  @@index([gradeCheckedAt])
  @@index([name])
}

/// One health inspection visit. Shared across users; kept even when nobody tracks the venue.
model RestaurantInspection {
  id          String            @id @default(cuid())
  profileId   String
  profile     RestaurantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source      String
  inspectedAt DateTime
  grade       String?
  score       Int?
  /// e.g. "Cycle Inspection / Initial Inspection", "Canvass", "Complaint"
  inspectionType String?
  /// [{ code, description, critical }]
  violations  Json
  sourceUrl   String?
  createdAt   DateTime          @default(now())

  @@unique([profileId, source, inspectedAt])
  @@index([profileId, inspectedAt(sort: Desc)])
}

/// Something that changed about a tracked restaurant (grade change, closure…), per user.
model RestaurantNotice {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String
  profile   RestaurantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  /// Free-form details (previous/next grade, inspection date…)
  data      Json?
  createdAt DateTime          @default(now())
  readAt    DateTime?
  pushedAt  DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([profileId, kind, createdAt(sort: Desc)])
}

enum MatchReason {
  upc_exact
  brand_match
  text_match
  scan_text_match
  restaurant_supplier
  category_subscription
}

model Alert {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recallId    String
  recall      Recall      @relation(fields: [recallId], references: [id], onDelete: Cascade)
  watchItemId String?
  watchItem   WatchItem?  @relation(fields: [watchItemId], references: [id], onDelete: SetNull)
  reason      MatchReason
  score       Float
  explanation String
  createdAt   DateTime    @default(now())
  readAt      DateTime?
  pushedAt    DateTime?
  pushTicket  String?
  /// User said "I don't have this" / "wrong match": hidden from the inbox.
  dismissedAt   DateTime?
  dismissReason String?
  /// User dealt with it (discarded / returned / contacted the company).
  resolvedAt    DateTime?
  resolvedAction String?

  @@unique([userId, recallId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([pushedAt])
}

/// A scanned receipt: what was bought, what was flagged. Kept so the user can revisit it.
model ReceiptScan {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store        String?
  purchasedAt  DateTime?
  itemCount    Int
  flaggedCount Int
  /// [{ raw, product, brand, terms, status, recallIds[] }]
  items        Json
  /// Whether the items were added to the watchlist.
  watched      Boolean  @default(false)
  decodedByAi  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

/// Remote MCP server connected by a premium user (grocery/delivery/shopping data).
model Connector {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  displayName    String
  mcpUrl         String
  /// AES-256-GCM encrypted token (see lib/crypto.ts). Null when the server needs no auth.
  tokenCiphertext String?
  lastSyncAt     DateTime?
  lastSyncStatus String    @default("never")
  lastSyncError  String?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

/// Token/cost accounting for premium AI calls, per user, for quotas and billing insight.
model AiUsage {
  id           String   @id @default(cuid())
  /// Null for system-initiated work (scheduled research refreshes) that no user is charged for.
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  provider     String   @default("anthropic")
  model        String
  inputTokens  Int
  outputTokens Int
  cacheReadTokens Int   @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}
